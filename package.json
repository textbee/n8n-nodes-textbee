{
	"name": "@textbee/n8n-nodes-textbee",
	"version": "1.0.0",
	"description": "Official n8n nodes for textbee.dev: send and receive SMS through your own Android phone",
	"license": "MIT",
	"packageManager": "pnpm@9.14.2",
	"homepage": "https://textbee.dev/docs/agents/n8n",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"textbee",
		"sms",
		"sms-gateway",
		"android"
	],
	"author": {
		"name": "textbee",
		"email": "contact@textbee.dev",
		"url": "https://textbee.dev"
	},
	"contributors": [
		"Julius Haring (https://github.com/JuliusHaring)"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/textbee/n8n-nodes-textbee.git"
	},
	"bugs": {
		"url": "https://github.com/textbee/n8n-nodes-textbee/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20.15.0"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --maxWorkers=2",
		"check:hygiene": "node scripts/hygiene.mjs",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/package.json",
		"!dist/tsconfig.tsbuildinfo",
		"LICENSE.md",
		"NOTICE.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TextbeeApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Textbee/Textbee.node.js",
			"dist/nodes/TextbeeTrigger/TextbeeTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.55.5",
		"@types/node": "22.20.5",
		"eslint": "9.29.0",
		"n8n-workflow": "2.16.0",
		"prettier": "3.9.10",
		"typescript": "5.9.3",
		"vitest": "5.1.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"pnpm": {
		"onlyBuiltDependencies": []
	}
}
